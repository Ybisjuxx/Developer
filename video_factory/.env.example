# -------------------------------------------------------------
# 100% Local Autonomous Video Factory Configuration
# Zero Cloud API Dependencies (No Google Cloud, No OpenAI)
# -------------------------------------------------------------

APP_NAME="Local Autonomous Video Factory"
APP_ENV=production
HOST=127.0.0.1
PORT=8000

# Local AI Engines
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=llama3.1:8b-instruct
OLLAMA_TIMEOUT_SECONDS=60.0

# Speech-To-Text (faster-whisper on CTranslate2)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true
WHISPER_MIN_SILENCE_DURATION_MS=500

# Audio & Video Rendering (FFmpeg)
AUDIO_CROSSFADE_SECONDS=0.02
AUDIO_DUCKING_DB=-22.0
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30

# Kinetic Subtitles Styling
SUBTITLE_FONT_NAME=Impact
SUBTITLE_FONT_SIZE=24
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=&H0000FFFF
SUBTITLE_BOTTOM_MARGIN=420

# Local ComfyUI / Automatic1111 (Optional Hook)
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Local n8n Webhook Integration
N8N_DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/video-complete
