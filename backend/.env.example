# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS - FARMACONTROL
# ==============================================================================
#
# 1. Para usar SQLite local (predeterminado):
# DATABASE_URL=sqlite:///farmacia.db
#
# 2. Para usar tu servidor MySQL local o en red:
# Reemplaza 'tu_contraseña' por tu contraseña de MySQL y especifica el nombre de la BD:
# DATABASE_URL=mysql+pymysql://root:tu_contraseña@localhost:3306/farmacontrol_db
#
# ==============================================================================
DATABASE_URL=sqlite:///farmacia.db

# ==============================================================================
# SEGURIDAD (añadido en auditoría v1.4.7)
# ==============================================================================
# Clave para firmar tokens de sesión. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FARMACONTROL_SECRET_KEY=
# 1 = todas las rutas exigen "Authorization: Bearer <token>" (activar en producción
#     cuando el frontend envíe el token). 0 = modo compatibilidad (token opcional).
AUTH_REQUIRED=0
TOKEN_TTL_SECONDS=43200
# Orígenes web permitidos (coma-separados). localhost siempre está permitido.
CORS_ORIGINS=https://ybisjuxx.github.io
