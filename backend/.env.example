# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS - FARMACONTROL
# ==============================================================================
#
# 1. Para usar SQLite local (predeterminado):
# DATABASE_URL=sqlite:///farmacia.db
#
# 2. Para usar tu servidor MySQL local o en red:
# Reemplaza 'tu_contraseña' por tu contraseña de MySQL y especifica el nombre de la BD:
# DATABASE_URL=mysql+pymysql://root:tu_contraseña@localhost:3306/farmacontrol_db
#
# ==============================================================================
DATABASE_URL=sqlite:///farmacia.db
